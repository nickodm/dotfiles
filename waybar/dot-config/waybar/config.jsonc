[
    {
        "layer": "top",
        "modules-left": ["tray"],
        "modules-center": ["clock#date", "clock#time", "idle_inhibitor"],
        "modules-right": ["network", "pulseaudio", "battery"],
        "network": {
            "format": "{essid}",
            "format-wifi": "<b>{essid}</b> {icon}",
            "format-ethernet": " ",
            "format-disconnected": "󰤮 ",
            "tooltip-format-ethernet": "Wired  ",
            "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
        },
        "pulseaudio": {
            "format": "<b>{volume}%</b> {icon}",
            "format-bluetooth": "<b>{volume}%</b> 󰂯",
            "format-muted": " ",
            "format-icons": [" ", " ", " "],
            "scroll-step": 5,
            "on-click": "pavucontrol"
        },
        "battery": {
            "format": "<b>{capacity}%</b>",
            "format-full": "󰁹",
            "format-charging": "<b>{capacity}%</b> 󱐋", 
            "format-plugged": "<b>{capacity}%</b> 󱐋", 
            "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "states": {
                "warning": 50,
                "critical": 30
            }
        },
        "clock#date": {
            "format": "<b>{:%a. %d-%m-%Y}</b> "
        },
        "clock#time": {
            "format": "<b>{:%H:%M}</b> 󰥔"
        },
        "idle_inhibitor": {
            "format": " "
        },
        "tray": {
            "spacing": 5
        }
    },
    {
        "layer": "top",
        "position": "bottom",
        "modules-left": ["hyprland/workspaces"],
        "modules-right": ["mpd", "cpu", "memory"],
        "hyprland/workspaces": {
            "format": "<b>{name}</b>{windows}",
            "format-window-separator": "",
            "expand": true,
            "workspace-taskbar": {
                "enable": true
            }
        },
        "cpu": {
            "format": "{usage}% "
        },
        "memory": {
            "format": "{percentage}% "
        },
        "mpd": {
            
        }
    }
]
