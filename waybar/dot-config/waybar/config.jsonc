[
    {
        "layer": "top",
        "modules-left": ["tray"],
        "modules-center": ["clock#date", "clock#time", "idle_inhibitor"],
        "modules-right": ["network", "bluetooth", "pulseaudio", "battery"],
        "network": {
            "format": "{essid}",
            "format-wifi": "<b>{essid}</b> {icon}",
            "format-ethernet": " ",
            "format-disconnected": "󰤮 ",
            "format-disabled": "󰤮 ",
            "tooltip-format-ethernet": "Wired  ",
            "tooltip-format-disconnected": "Disconnected 󰤮 ",
            "tooltip-format-disabled": "Disabled 󰤮 ",
            "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
        },
        "bluetooth": {
            "format": "󰂯",
            "format-disabled": "󰂲",
            "format-connected": "<b>{device_alias}</b> 󰂯",
            "tooltip-format-off": "<b>OFF</b>",
            "tooltip-format-on": "<b>ON</b>",
            "tooltip-format-connected": "<b>{device_alias} ({device_battery_percentage}%)</b> 󰂯",
            "on-click": "blueman-manager",
            "on-click-right": "rfkill toggle bluetooth"
        },
        "pulseaudio": {
            "format": "<b>{volume}%</b> {icon}",
            "format-bluetooth": "<b>{volume}%</b> 󰂯",
            "format-muted": " ",
            "format-icons": [" ", " ", " "],
            "scroll-step": 5,
            "on-click": "pavucontrol",
            // Toggle mute of the current sink
            "on-click-right": "wpctl set-mute $(wpctl list audio sinks | grep \\* | awk '{print $1}') toggle"
        },
        "battery": {
            "format": "<b>{capacity}%</b>",
            "format-full": "󰁹",
            "format-charging": "<b>{capacity}%</b> 󱐋", 
            "format-plugged": "<b>{capacity}%</b> 󱐋", 
            "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "states": {
                "warning": 50,
                "critical": 30
            }
        },
        "clock#date": {
            "format": "<b>{:%a. %d-%m-%Y}</b> "
        },
        "clock#time": {
            "format": "<b>{:%H:%M}</b> 󰥔"
        },
        "idle_inhibitor": {
            "format": " "
        },
        "tray": {
            "spacing": 5
        }
    },
    {
        "layer": "top",
        "position": "bottom",
        "modules-left": ["hyprland/submap", "hyprland/workspaces"],
        "modules-right": ["temperature", "cpu", "memory"],
        "hyprland/workspaces": {
            "format": "<b>{name}</b>{windows}",
            "format-window-separator": "",
            "expand": true,
            "show-special": true,
            "special-visible-only": true,
            "workspace-taskbar": {
                "enable": true
            }
        },
        "hyprland/submap": {
            "format": "<b>{}</b>"
        },
        "temperature": {
            "format": "{temperatureC}°C {icon}",
            "format-icons": ["", "", "", "", ""],
            "warning-thereshold": 60,
            "critical-thereshold": 80
        },
        "cpu": {
            "format": "{usage}% "
        },
        "memory": {
            "format": "{percentage}% "
        }
    }
]
