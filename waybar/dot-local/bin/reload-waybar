#! /usr/bin/bash

start_waybar() {
    waybar 2> /dev/null > /dev/null &
}

if pidof -q "waybar"; then
    killall "waybar"
    systemd-cat -t reload-waybar <<< "KILLED WAYBAR"
    start_waybar
    notify-send "Waybar" "Waybar reloaded."
else
    start_waybar

    if pidof -q "waybar"; then
        notify-send "Waybar" "Waybar initialized."
    else
        notify-send "Waybar" "Error while loading waybar."
    fi
fi
