# /usr/bin/zsh
# Zsh 5.9.2

# --- OPTIONS ---

# Spell-checking for commands
setopt correct

# --- KEY BINDINGS ---

bindkey ^H vi-backward-kill-word

# --- ENVIRONMENT VARIABLES ---

command_exists() {
    command -v "$1" > /dev/null 2>&1
}

export PATH="$HOME/.local/bin:$PATH"

command_exists "pnpm" && export PATH="$PATH:$HOME/.local/share/pnpm/bin"
command_exists "nvim" && export EDITOR="nvim" || export EDITOR="vim"

[[ -d "$HOME/dotfiles" ]] && export STOW_DIR="$HOME/dotfiles"

# --- ALIASES ---

alias ls="ls --color=auto"

command_exists "tree" && alias tree="tree -C"
command_exists "nvim" && alias vim="nvim"

# --- CUSTOM FUNCTIONS ---

omptheme() {
    if ! command_exists "oh-my-posh"; then
        echo "Error: oh-my-posh is not installed." >&2
        return 1
    fi

    local ompconfig="$HOME/.config/oh-my-posh"
    omptheme="$ompconfig/$1.toml"
    if [[ ! -f "$omptheme" ]]; then
        echo "Error: There isn't a theme named like that." >&2
        return 1
    fi

    eval $(oh-my-posh init zsh -c "$omptheme")
}

dot-zsh() {
    . "$HOME/.zshrc"
}

# --- INIT ---

if [[ $(tty) == /dev/tty* ]]; then
    command_exists "oh-my-posh" && omptheme simple

    if command_exists "fastfetch"; then
        fastfetch
    elif command_exists "neofetch"; then
        neofetch
    fi
else
    command_exists "oh-my-posh" && omptheme main
fi

if command_exists "pyenv"; then
    export PYENV_ROOT="$HOME/.pyenv"
    [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init - zsh)"
fi

unset -f command_exists
